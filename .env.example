# Butler configuration. Copy to .env and fill in. Never commit .env.
# Plugs themselves live in plugs.json (see plugs.example.json); devices added from Telegram
# are stored on the server in $DATA_DIR/plugs_changes.json.

# --- Telegram (required) ---
# Create a bot with @BotFather → /newbot, paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot. Leave empty, message the bot, it replies with your ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Natural language (optional, free) ---
# Gemini key from aistudio.google.com/apikey (create it in a Google project WITHOUT billing).
# Without it, a built-in offline parser handles commands and voice notes are unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- How plugs are controlled ---
# local = over your home Wi-Fi (needs ip + local_key per plug; the bot must run at home)
# cloud = via Tuya's cloud API (works from anywhere, e.g. the Oracle VM — the server sets this itself)
TUYA_TRANSPORT=local
# Tuya cloud credentials (project Overview → Authorization Key). If empty, tinytuya.json
# written by `python -m tinytuya wizard` is used instead.
TUYA_API_KEY=
TUYA_API_SECRET=
TUYA_API_REGION=in
# Real-time updates via Tuya Message Service (must be enabled on the Tuya project, see AGENTS.md §2).
TUYA_PUSH=true

# --- Apple Shortcuts / Watch API (optional) ---
# Random secret; enables a token-protected HTTPS API (Caddy in front, see deploy/https.sh).
API_TOKEN=
PUBLIC_URL=https://<server-ip-with-dashes>.sslip.io

# --- Behaviour ---
# Phone notification when a device changes without you doing it from the chat (schedules, app, auto-off).
NOTIFY_STATE_CHANGES=true
# Background check interval (seconds). While Tuya pushes are flowing, real reads happen only every 6 h.
ENERGY_POLL_SECONDS=300
# Location for sunrise/sunset schedules (default: Bengaluru).
LATITUDE=12.9716
LONGITUDE=77.5946

# --- Storage ---
# Schedules, energy history, logs, dashboard state, devices added from Telegram.
DATA_DIR=~/.butler
